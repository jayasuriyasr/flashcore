POSTGRES_DB=flashcore
POSTGRES_USER=flashcore
POSTGRES_PASSWORD=flashcore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
KAFKA_BOOTSTRAP=kafka:9092

# Shared by Django (signs JWTs) and the gateway (verifies them). HS256.
JWT_SIGNING_KEY=dev-only-change-me-0123456789abcdef

DJANGO_SECRET_KEY=dev-only-django-secret-change-me
DJANGO_DEBUG=1

# Mock payment used by Celery fulfilment
PAYMENT_FAILURE_RATE=0.05
MOCK_PAYMENT_DELAY_MS=100

# Deployment only (docs/DEPLOY.md); empty = local defaults.
# DJANGO_ALLOWED_HOSTS=1-2-3-4.sslip.io,localhost,127.0.0.1,web
# CSRF_TRUSTED_ORIGINS=https://1-2-3-4.sslip.io
# CORS_ALLOWED_ORIGINS=https://flashcore.vercel.app

# Host ports of the optional dashboards (docker compose --profile observability up -d),
# if 9090 or 3000 is already taken on your machine.
# PROMETHEUS_PORT=9091
# GRAFANA_PORT=3001
